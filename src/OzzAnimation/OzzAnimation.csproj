<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OzzAnimation</AssemblyName>
    <RootNamespace>OzzAnimation</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>OzzAnimation.NET</PackageId>
    <Version>0.17.0</Version>
    <Title>OzzAnimation.NET</Title>
    <Authors>quabug</Authors>
    <Description>A managed, SIMD, allocation-free C# port of the ozz-animation runtime: sampling, blending (weighted, partial and additive), two-bone and aim IK, user-channel tracks and triggering, root-motion blending. Byte-compatible with ozz-animation 0.17 archives. No native code, trimmable and NativeAOT-compatible.</Description>
    <PackageProjectUrl>https://github.com/ParadiseEngine/OzzAnimation.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ParadiseEngine/OzzAnimation.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>animation;skeleton;skinning;ozz;simd;ik;blending;nativeaot;game-dev</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
