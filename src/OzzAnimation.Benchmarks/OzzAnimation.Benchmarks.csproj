<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OzzAnimation.Benchmarks</AssemblyName>
    <RootNamespace>OzzAnimation.Benchmarks</RootNamespace>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OzzAnimation/OzzAnimation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../OzzAnimation.Tests/Fixtures/bench-*.ozz" LogicalName="bench.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
